# Copia a .env y añade tu clave. Nunca publiques .env.
GEMINI_API_KEY=
GEMINI_DAILY_BUDGET_EUR=3
# Opcional: por defecto usa la zona del país elegido.
# BUDGET_TIMEZONE=Europe/Madrid
# Tu propio ID de Amazon; vacío para no usar afiliación.
AMAZON_ASSOCIATE_TAG=
# Preparado y desactivado. No hay opciones de Telegram en el panel.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Avisos automáticos a Discord. Crea un webhook en el canal:
# Ajustes del canal → Integraciones → Webhooks → Nuevo webhook → Copiar URL.
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=true
# Usuario a mencionar cuando llega un chollo (ID de Discord; vacío para no mencionar).
DISCORD_MENTION_USER_ID=
# Webhook aparte para el pulso "sigo buscando ofertas" cada X minutos.
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_STATUS_ENABLED=true
DISCORD_HEARTBEAT_MINUTES=30
# URL pública de este despliegue (Render, etc.) para mantenerlo despierto con auto-ping.
# SELF_URL=https://tu-servicio.onrender.com
